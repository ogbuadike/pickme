<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only (docs/SECURITY_CONTRACT.md §1). User-installed CAs are not
     trusted in release builds; debug builds additionally trust them so local
     proxies (Charles/mitmproxy) can be used during development. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
