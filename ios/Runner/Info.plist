<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Pick Mee</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Pick Me</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!-- Google Maps iOS key, injected from ios/Flutter/Secrets.xcconfig
         (git-ignored; see Secrets.xcconfig.example). Read in AppDelegate. -->
    <key>GMSApiKey</key>
    <string>$(GOOGLE_MAPS_IOS_API_KEY)</string>

    <!-- Only standard HTTPS/TLS is used (export-compliance exemption). -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>LSApplicationQueriesSchemes</key>
    <array>
      <string>tel</string>
      <string>mailto</string>
      <string>https</string>
    </array>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- local_auth: unlock with Face ID instead of typing the PIN. -->
    <key>NSFaceIDUsageDescription</key>
    <string>Pick Me uses Face ID so you can unlock the app and approve wallet payments without typing your PIN.</string>

    <!-- Riders and drivers: pickup point, nearby drivers, fares. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Pick Me uses your location to set your pickup point, show nearby drivers and calculate trip fares. Drivers' locations are shared with their rider during an active trip.</string>

    <!-- Required by App Store static checks because the location plugin can
         request "Always". The app only asks for "While Using"; drivers'
         active trips continue in the background via UIBackgroundModes. -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Drivers: Pick Me keeps sharing your location with your rider while a trip you accepted is in progress, even if you switch to another app. Location is not tracked when you are offline.</string>

    <!-- image_picker: package photo (Send Me / Dispatch) and driver documents. -->
    <key>NSCameraUsageDescription</key>
    <string>Pick Me uses the camera so you can photograph a package for delivery or capture your driver documents.</string>

    <!-- image_picker: profile picture, package photo, driver documents. -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Pick Me lets you choose a photo for your profile picture, a package for delivery, or your driver documents.</string>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <!-- location: drivers' active-trip tracking only.
         remote-notification: FCM data messages (trip status updates). -->
    <key>UIBackgroundModes</key>
    <array>
       <string>location</string>
       <string>remote-notification</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
       <string>UIInterfaceOrientationPortrait</string>
       <string>UIInterfaceOrientationLandscapeLeft</string>
       <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
       <string>UIInterfaceOrientationPortrait</string>
       <string>UIInterfaceOrientationPortraitUpsideDown</string>
       <string>UIInterfaceOrientationLandscapeLeft</string>
       <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>